# Generate private keys with: python scripts/init_env.py
# Never share .env or use the same keys across independent installations.
SECRET_KEY=

MYSQL_HOST=127.0.0.1
MYSQL_USER=devicetrust
MYSQL_PASSWORD=your-password
MYSQL_DB=devicetrust

FLASK_HOST=127.0.0.1
FLASK_PORT=7070
FLASK_DEBUG=False

# 设备授权接口端口（默认 8080，与原先 verification.py 一致）
AUTHORIZE_PORT=8080
# 本地测试客户端 request_auth.py 连接地址
AUTHORIZE_HOST=127.0.0.1

# 业务线：铝水设备可不传 tenant（默认 lvshui）；元一设备请求体需带 "tenant":"yuanyi"

# 授权加解密（与设备端保持一致）
AES_KEY=
DES_KEY=
DES_IV=

# 设备「长期未授权」判定天数
STALE_DAYS=7

# 授权策略（0 表示不限制）
DAILY_AUTH_LIMIT_PER_DEVICE=50
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_IP=30
RATE_LIMIT_MAX_PER_CPU=20
AUTH_CODE_MAX_AGE_SECONDS=86400
LOG_RETENTION_DAYS=90
